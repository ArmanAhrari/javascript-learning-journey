// score *= 4;   // Multiplication assignment
// score /= 4;   // Division assignment
// score %= 4;   // Remainder assignment
// score **= 4;  // Exponentiation assignment

console.log(score);


// =========================================
// 4. Comparison Operators
// =========================================

const numberA = 5;
const numberB = 2;
const numberString = "5";
const anotherNumber = 5;

// Loose equality
console.log(numberA == numberString);
console.log(numberA == numberB);
console.log(numberA == anotherNumber);

// Loose inequality
console.log(numberA != numberString);
console.log(numberA != numberB);

// Strict equality
console.log(numberA === numberString);

// Strict inequality
console.log(numberA !== anotherNumber);

// Greater than and less than
console.log(numberA > anotherNumber);
console.log(numberA >= anotherNumber);
console.log(numberA < numberB);
console.log(numberA <= anotherNumber);


// =========================================
// 5. Logical Operators
// =========================================

const age = 4;
const minimumAge = 3;
const maximumAge = 4;

// AND operator
console.log(age > minimumAge && age >= maximumAge);

// OR operator
console.log(age > minimumAge || age > maximumAge);

// NOT operator
console.log(!true);

// Negate a comparison result
console.log(!(age > minimumAge));


// =========================================
// 6. Unary Operators
// =========================================

// Unary Plus: Convert a numeric string into a number
const numericString = "5";

const convertedNumber = +numericString;
console.log(convertedNumber);
console.log(typeof convertedNumber);


// Unary Minus: Reverse the sign of a number
const originalNumber = -5;

const negativeResult = -originalNumber;
console.log(negativeResult);


// =========================================
// 7. Nullish Coalescing Operator (??)
// =========================================

// Return the default value when the first value is null or undefined
let userName;

const defaultName = "Guest";

console.log(userName ?? defaultName);


// Return the existing value when it is not null or undefined
let registeredName = "Arman";

const fallbackName = "Guest";

console.log(registeredName ?? fallbackName);

