
// =========================================
// 1. Arithmetic Operators
// =========================================

// Addition (+)
console.log(5 + 3);

const firstNumber = 5;
const secondNumber = 3;

console.log(firstNumber + secondNumber);

const additionResult = firstNumber + secondNumber;
console.log(additionResult);


// Subtraction (-)
console.log(5 - 3);

const minuend = 5;
const subtrahend = 3;

const subtractionResult = minuend - subtrahend;
console.log(subtractionResult);


// Multiplication (*)
console.log(5 * 3);

const multiplicand = 5;
const multiplier = 3;

const multiplicationResult = multiplicand * multiplier;
console.log(multiplicationResult);


// Division (/)
console.log(5 / 3);

const dividend = 5;
const divisor = 3;

const divisionResult = dividend / divisor;
console.log(divisionResult);


// Exponentiation (**)
console.log(5 ** 3);

const baseNumber = 5;
const exponent = 3;

const powerResult = baseNumber ** exponent;
console.log(powerResult);


// Modulus (%)
console.log(5 % 3);

const dividendNumber = 5;
const divisorNumber = 3;

const remainderResult = dividendNumber % divisorNumber;
console.log(remainderResult);


// =========================================
// 2. Increment & Decrement Operators
// =========================================

// Increment a variable using addition
let counter = 3;

counter = counter + 1;
console.log(counter);


// Increment a variable using the increment operator
let incrementCounter = 3;

incrementCounter++;
console.log(incrementCounter);


// Decrement a variable using the decrement operator
let decrementCounter = 3;

decrementCounter--;
console.log(decrementCounter);


// =========================================
// 3. Assignment Operators
// =========================================

let score = 2;

// Increase the variable by 4
score += 4;

// Other assignment operators:
