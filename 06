
// ========================================
// 1. If / Else Statements
// ========================================

const number = 10;

if (number > 8) {
    console.log(`${number} is greater than 8`);
} else {
    console.log(`${number} is less than or equal to 8`);
}

// ========================================
// 2. Positive, Negative or Zero
// ========================================

const secondNumber = 4;

if (secondNumber > 0) {
    console.log("The number is positive");
} else if (secondNumber < 0) {
    console.log("The number is negative");
} else {
    console.log("The number is zero");
}

// ========================================
// 3. Type Checking with typeof
// ========================================

const thirdNumber = 10;

if (typeof thirdNumber === "number" && thirdNumber >= 0) {
    console.log("This is a valid non-negative number");
} else {
    console.log("This is not a valid non-negative number");
}

// ========================================
// 4. If / Else If / Else
// ========================================

const userName = "arman";

if (userName === "arman") {
    console.log("You are Arman");
} else if (userName === "ali") {
    console.log("You are Ali");
} else {
    console.log("I don't know you");
}

// ========================================
// 5. Switch Statement
// ========================================

switch (userName) {
    case "arman":
        console.log("You are Arman");
        break;

    case "ali":
        console.log("You are Ali");
        break;

    default:
        console.log("I don't know you");
}

// ========================================
// 6. For Loop
// ========================================

for (let i = 1; i <= 10; i++) {
    console.log(i);
}

// ========================================
// 7. For Loop with Arrays
// ========================================

const numbersArray = [2, 4, 6, 8];

for (let i = 0; i < numbersArray.length; i++) {
    console.log(numbersArray[i] * 2);
}

// ========================================
// 8. For...Of Loop
// ========================================

const secondArray = [2, 4, 6, 8];

for (const number of secondArray) {
    console.log(number * 2);
}

// ========================================
// 9. For...In Loop with Objects
// ========================================

const user = {
    name: "arman",
    lastName: "ahrari",
    age: 23
};

for (const key in user) {
    console.log(key, user[key]);
}

// ========================================
// 10. While Loop
// ========================================

for (let i = 0; i <= 10; i++) {
    console.log(i);
}

let counter = 10;

while (counter <= 20) {
    console.log(counter);
    counter++;
}

// ========================================
// 11. While Loop with Condition
// ========================================

let isRunning = true;
let counter2 = 1;

while (isRunning) {
    console.log(counter2);

    counter2++;

    if (counter2 === 10) {
        isRunning = false;
    }
}

// ========================================
// 12. Do...While Loop
// ========================================

let counter3 = 11;

do {
    console.log(counter3);
    counter3++;
} while (counter3 < 10);

// ========================================
// 13. Break Statement
// ========================================

const mixedArray = [1, 2, 3, 4, "f", 5, 6];

for (const item of mixedArray) {
    if (typeof item !== "number") {
        break;
    }

    console.log(item);
}

// ========================================
// 14. Continue Statement
// ========================================

const anotherMixedArray = [1, 2, 3, 4, "f", 5, 6];

for (const item of anotherMixedArray) {
    if (typeof item !== "number") {
        continue;
    }

    console.log(item);
}
